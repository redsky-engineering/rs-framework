		},
		"./utils/index.js": {
			"import": "./utils/index.js",
			"types": "./utils/index.d.ts"
		},
		"./ui": {
			"import": "./ui/index.js",
			"types": "./ui/index.d.ts"
		},
		"./ui/index.js": {
			"import": "./ui/index.js",
			"types": "./ui/index.d.ts"
		},
		"./hooks": {
			"import": "./hooks/index.js",
			"types": "./hooks/index.d.ts"
		},
		"./hooks/index.js": {
			"import": "./hooks/index.js",
			"types": "./hooks/index.d.ts"
		},
		"./996": {
			"import": "./996/index.js",
			"types": "./996/index.d.ts"
		},
		"./996/index.js": {
			"import": "./996/index.js",
			"types": "./996/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.3.1",
		"@commitlint/config-conventional": "^20.3.1",
		"@babel/core": "^7.29.0",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@storybook/addon-docs": "^10.3.6",
		"@storybook/addon-links": "^10.3.6",
		"@storybook/addon-webpack5-compiler-swc": "^4.0.0",
		"@storybook/react-webpack5": "^10.3.6",
		"@types/aos": "^3.0.7",
		"@types/lodash.clone": "^4.5.9",
		"@types/lodash.clonedeep": "^4.5.9",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"autoprefixer": "^10.5.0",
		"babel-loader": "^10.1.1",
		"commit-and-tag-version": "^12.7.3",
		"css-loader": "^7.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.6",
		"postcss-loader": "^8.1.1",
		"prettier": "3.7.4",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"rimraf": "^6.1.2",
		"rollup": "^4.60.3",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-visualizer": "^6.0.5",
		"sass": "^1.97.1",
		"sass-embedded": "^1.97.1",
		"sass-loader": "^16.0.6",
		"storybook": "^10.3.6",
		"style-loader": "^4.0.0",
		"typescript": "^5.9.3",
		"webpack": "^5.104.1"
	},
	"peerDependencies": {
		"react": "^18.3.1 || ^19.0.0",
		"react-dom": "^18.3.1 || ^19.0.0"
	},
	"dependencies": {
		"@capacitor/core": "^8.3.3",
		"@capacitor/haptics": "^8.0.2",
		"@lottiefiles/lottie-player": "^2.0.12",
