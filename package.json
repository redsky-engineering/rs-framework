		"react-select": "5.10.2",
		"react-toastify": "^11.0.5",
		"tslib": "^2.8.1"
	},
	"scripts": {
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"build": "pnpm run build:prebuild && pnpm run build:bundle && pnpm run build:postbuild",
		"build:local": "pnpm run build && cd dist && pnpm pack && mv *.tgz ../.",
		"build:publish": "pnpm run build && pnpm publish dist",
		"build:prebuild": "rimraf dist",
		"build:bundle": "rollup -c",
		"build:postbuild": "node scripts/postbuild.js",
		"prettier:check": "prettier --check ./src/**/*.{ts,tsx,js,jsx,html,scss,css,md,json}",
		"prettier:fix-all": "prettier --write ./src/**/*.{ts,tsx,js,jsx,html,scss,css,md,json}",
		"release:patch": "commit-and-tag-version --release-as patch",
		"release:minor": "commit-and-tag-version --release-as minor",
		"release:major": "commit-and-tag-version --release-as major",
		"release:pre:alpha": "commit-and-tag-version --prerelease alpha",
		"prepare": "husky",
		"checkCommit": "pnpx commitlint --edit $1 -V"
	},
	"bin": {
		"rsf": "cli/cli.mjs"
	},
	"types": "index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,html,scss,css,md,mdx,json}": "prettier --write"
	}
}
